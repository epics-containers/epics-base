#!/bin/bash

################################################################################
# generic local build script for epics-containers repositories                 #
################################################################################

set -e

# set EPICS_TARGET_ARCH to RTEMS-beatnik for RTEMS based targets. Unset means
# a native build for the host platform (linux-x86_64 or linux-aarch64)
T_A=${EPICS_TARGET_ARCH}
# set TARGET to runtime for runtime images
TARGET=${TARGET:-developer}
# set TAG to override the default tag
TAG=${TAG:-ec_test}

# BASE_IMAGE defaults to the ARG in the Dockerfile unless overridden here
if [ "$T_A" = "RTEMS-beatnik" ]; then
    BASE_IMAGE="ghcr.io/epics-containers/rtems-beatnik-runtime:6.1ec4"
fi
if [ -n "$BASE_IMAGE" ]; then
    base_arg="--build-arg BASE_IMAGE=$BASE_IMAGE"
fi
if [ -n "$T_A" ]; then
    t_a_arg="--build-arg EPICS_TARGET_ARCH=$T_A"
fi

cd $(dirname ${0})

# use docker if available else use podman
if ! docker version &>/dev/null; then docker=podman; else docker=docker; fi
if $docker buildx version &>/dev/null; then buildx=buildx; load='--load --progress=plain'; fi

# make sure new repos get their submodule ibek-support
if [ ! -d ibek-support ] ; then git submodule update --init ; fi

# build and developer images
set -x
$docker $buildx build -t ${TAG} "${@}" $load \
    $t_a_arg \
    $base_arg \
    --target $TARGET .

